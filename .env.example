# Optional server-only authorized playback configuration.
# JSON array; each item needs malId, episode, language, serverName and one playback source.
AUTHORIZED_VIDEO_SOURCES_JSON=
# Optional upload provider configuration for automatic anime source uploads.
# Examples: custom, supabase, cloudflare, mux
VIDEO_UPLOAD_PROVIDER=custom
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=anime-videos
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOM_DOMAIN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional Cloudflare Stream custom domain used with cloudflareVideoUid.
CLOUDFLARE_STREAM_CUSTOM_DOMAIN=

# Central API configuration
API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_BASE_URL=
ANILIST_API_URL=https://graphql.anilist.co
ANIME_API_BASE_URL=
VIDEO_SOURCE_BASE_URL=
M3U8_PROXY_URL=
AUTHORIZED_MEDIA_HOSTS=

# Protects /admin and /api/admin. Use a long random value; never commit the real value.
ADMIN_ACCESS_TOKEN=change-this-to-a-long-random-secret
